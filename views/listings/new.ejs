<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row mt-3">
        <div class="col-8 offset-2">
        <h3>Create new Listing</h3>
        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-lebel">Title</label>
                <input type="text" name="listing[title]" placeholder="enter title" class="form-control" required >
                <div class="valid-feedback">Title looks good</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-lebel">Description</label>
                <textarea type="text" name="listing[description]" placeholder="enter description"
                    class="form-control" required></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-lebel">Upload Listing Image</label>
                <input type="file" name="listing[image][url]" class="form-control" required>
            </div>
            <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-lebel">Price</label>
                <input type="number" name="listing[price]" placeholder="500" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid price</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-lebel">Country</label>
                <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid country name</div>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-lebel">location</label>
            <input type="text" name="listing[location]" placeholder="New Town, Kolkata,West Bengal" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid location name</div>
        </div>
            <button class="btn btn-dark add-btn mt-3">Add</button><br><br><br><br>
        </form>
        </div>
        </div>
    </body>